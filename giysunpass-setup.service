[Unit]
Description=GiysunPASS first boot installation
Wants=network-online.target
After=network-online.target cloud-final.service
ConditionPathExists=!/var/lib/giysunpass-install/prepared

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/giysunpass-media/ilk-kurulum.sh
TimeoutStartSec=45min
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
